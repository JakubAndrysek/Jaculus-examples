{
    "name": "template-jaculus",
    "version": "0.1.0",
    "description": "Default Jaculus TS template project",
    "type": "module",
    "main": "./build/index.js",
    "files": [
        "build/**/*"
    ],
    "dependencies": {
        "@types/jaculus": "0.1.0",
        "colors": "0.1.0"
    },
    "devDependencies": {
        "tsx": "^4.20.6",
        "typescript": "^5.9.3"
    },
    "scripts": {
        "test": "tsx --test test/**/*.test.ts",
        "typecheck": "find src -type f -name '*.ts' -print0 | xargs -0 tsc --noEmit --target es2023 --module nodenext --lib es2023 --moduleResolution nodenext --types jaculus --rootDir src"
    },
    "jaculus": {
        "packageFormat": 1,
        "projectType": "code",
        "template": true,
        "registry": [
            "https://registry.jaculus.org/"
        ]
    }
}
